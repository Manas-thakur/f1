{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterlap.local/schemas/track-package-v1.json",
  "title": "AFTERLAP track package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track_id", "display_name", "direction", "nominal_length_m", "geometry", "features", "sources", "validation", "package_hash"],
  "properties": {
    "schema_version": {"const": "1"},
    "track_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "direction": {"enum": ["clockwise", "counterclockwise", "mixed"]},
    "nominal_length_m": {"type": "number", "exclusiveMinimum": 0},
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_spacing_m", "point_count", "crs", "arrays_path", "corridor_quality"],
      "properties": {
        "sample_spacing_m": {"type": "number", "exclusiveMinimum": 0},
        "point_count": {"type": "integer", "minimum": 0},
        "crs": {"type": ["string", "null"]},
        "arrays_path": {"type": ["string", "null"]},
        "corridor_quality": {"enum": ["surveyed", "validated_estimate", "unknown"]}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_finish_s_m", "sectors", "corners", "pit_lane_excluded"],
      "properties": {
        "start_finish_s_m": {"type": "number", "minimum": 0},
        "sectors": {"type": "array", "items": {"$ref": "#/$defs/range"}},
        "corners": {"type": "array", "items": {"$ref": "#/$defs/namedRange"}},
        "pit_lane_excluded": {"type": "boolean"}
      }
    },
    "event_overlay": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["event_id", "ruleset_hash", "fia_documents", "detection_lines_m", "activation_lines_m", "straight_mode_ranges"],
      "properties": {
        "event_id": {"type": "string"},
        "ruleset_hash": {"type": "string"},
        "fia_documents": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "detection_lines_m": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "activation_lines_m": {"type": "array", "items": {"type": "number", "minimum": 0}},
        "straight_mode_ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "closure_error_m", "length_error_fraction", "report_path"],
      "properties": {
        "status": {"enum": ["discovered", "geometry_validated", "event_rules_validated", "condition_calibrated", "simulation_eligible", "rejected"]},
        "closure_error_m": {"type": ["number", "null"], "minimum": 0},
        "length_error_fraction": {"type": ["number", "null"], "minimum": 0},
        "report_path": {"type": ["string", "null"]}
      }
    },
    "package_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "range": {
      "type": "object", "additionalProperties": false, "required": ["start_s_m", "end_s_m"],
      "properties": {"start_s_m": {"type": "number", "minimum": 0}, "end_s_m": {"type": "number", "minimum": 0}}
    },
    "namedRange": {
      "type": "object", "additionalProperties": false, "required": ["id", "start_s_m", "end_s_m"],
      "properties": {"id": {"type": "string"}, "start_s_m": {"type": "number", "minimum": 0}, "end_s_m": {"type": "number", "minimum": 0}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "title", "url", "retrieved_at", "sha256", "permission"],
      "properties": {
        "source_id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"}, "sha256": {"type": ["string", "null"]}, "permission": {"type": "string"}
      }
    }
  }
}
