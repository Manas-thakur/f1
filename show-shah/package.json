{
  "name": "@afterlap/show-shah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18940 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 18940 --strictPort",
    "studio": "remotion studio src/video.tsx --port 18941",
    "render": "remotion render src/video.tsx ShowShah dist/show-shah.mp4 --crf=18 --concurrency=4 --gl=angle",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build && bun run scripts/check.ts",
    "export": "bun run scripts/export.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "@remotion/three": "4.0.523",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.523",
    "reveal.js": "5.2.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@remotion/cli": "4.0.523",
    "@types/bun": "1.3.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/reveal.js": "5.2.2",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
