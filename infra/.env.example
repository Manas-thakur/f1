# Copy to infra/.env and fill in. infra/.env is NOT tracked and must never be.
#
# There is no default value for the database password anywhere in this package:
# docker-compose.yml uses `${AFTERLAP_DB_PASSWORD:?...}`, so `docker compose up`
# refuses to start until you set one. That refusal is the feature — a stack
# that boots with a shipped password is a stack with a published password.
#
# Generate one, do not invent one by hand:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

AFTERLAP_DB_PASSWORD=

# development | production. `development` enables the bootstrap operator
# identity used by the console (`console-operator`). In `production` the
# bootstrap is refused and every command needs a real authenticated operator,
# which this release does not yet provide — so a production value currently
# means "no one can operate a session", by design rather than by accident.
AFTERLAP_ENV=development

# Host-side publishes. All three bind 127.0.0.1 in docker-compose.yml; these
# only choose which loopback port.
AFTERLAP_WEB_PORT=8080
AFTERLAP_API_PORT=8010
AFTERLAP_DB_PORT=5433

# Disk budget for the artefact root, in bytes. Experiment output stops at the
# first ceiling; the second is the headroom held back for operational evidence
# (decisions, executions, the spool and exports) so an experiment can never
# starve the audit trail. Defaults: 2 GiB and 256 MiB.
AFTERLAP_EXPERIMENT_QUOTA_BYTES=2147483648
AFTERLAP_OPERATIONAL_RESERVE_BYTES=268435456

# Ceiling on the batch worker's CPU share, so long rollouts cannot crowd out
# the session runtime.
AFTERLAP_BATCH_CPUS=2.0
