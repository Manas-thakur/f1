  },
  "overrides": [
    {
      "includes": ["**/*.json"],
      "formatter": {
        "enabled": true
      }
    },
    {
      "includes": [
        "apps/web/e2e-live/**",
        "apps/web/playwright.live.config.ts",
        "apps/web/src/server/**",
        "apps/web/src/app/api/v1/sessions/*/stream/route.ts"
      ],
      "formatter": {
        "enabled": true
      }
    },
    {
      "includes": [
        "apps/web/src/styles/base.css",
        "apps/web/src/styles/workspace.module.css",
        "apps/web/src/shell/shell.module.css",
        "apps/web/src/components/charts/chart.module.css"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/styles/workspace.module.css", "apps/web/src/shell/shell.module.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/DataTable.tsx", "apps/web/src/components/charts/ChartFrame.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/server/**",
        "apps/web/src/instrumentation.ts",
        "apps/web/src/app/api/**",
        "apps/web/src/app/metrics/route.ts",
        "apps/web/*.ts",
        "apps/web/e2e/**",
        "apps/web/e2e-live/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "apps/web/src/test/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "apps/web/src/test/**",
        "apps/web/e2e/**",
        "apps/web/e2e-live/**"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          },
          "style": {
            "useGlobalThis": "off"
          },
          "suspicious": {
            "useAwait": "off",
            "noEmptyBlockStatements": "off"
          },
          "complexity": {
            "useMaxParams": "off"
          }
        }
      }
    }
